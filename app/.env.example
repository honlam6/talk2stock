# Talk2Stock 环境变量模板。复制为 .env 后填入真实值：
#   cp app/.env.example app/.env
#
# 说明：app/.env 已被 .gitignore 忽略，密钥不会进仓库。
#       也可以完全不动这个文件，直接在 AI 录入页面右上角「⚙ 模型设置」里配置模型——
#       页面填的 Key 会自动写回 app/.env，同样不会出现在 config.json 里。

# ---- ERP 连接 ----
T2S_ERP_BASE=http://localhost:9999/jshERP-boot
T2S_ERP_USER=jsh
T2S_ERP_PASS=

# ---- LLM 档案密钥（命名规则：T2S_KEY_<档案名大写>）----
# 与 app/config.json 里 llm.profiles 的档案 key 对应；页面配置时会自动写入这里。
T2S_KEY_DEEPSEEK=
T2S_KEY_OPENAI=
T2S_KEY_QWEN=

# ---- 访问口令 ----
# 设为 1 后，所有 /api 接口必须带对口令（请求头 X-T2S-Pass 或 Authorization: Bearer）。
# 本地开发保持 0 即可；公网部署强烈建议设为 1。
T2S_REQUIRE_AUTH=0
T2S_DEMO_PASS=talk2stock

# ---- 登录与角色（ERP 账号联动）----
# 开启鉴权后，成员用 ERP 账号密码登录（服务端转发 ERP 校验，密码不落盘）；
# ERP ismanager=1 的账号自动成为管理员。此处可额外指定管理员名单（逗号分隔登录名）。
T2S_ADMINS=
# 会话有效期（天），默认 30。会话是 HMAC 无状态签名，服务重启不失效。
T2S_SESSION_TTL_DAYS=30
